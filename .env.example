# ====================================================================
# PatchShield Environment Configuration (.env)
# SMB-Friendly AI-Assisted Virtual Patching Gateway
# ====================================================================

# Security & Secrets
SECRET_KEY=replace-with-a-secure-random-secret-key-32-chars-min
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Server Settings
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173", "http://127.0.0.1:3000"]

# Database & Storage
SQLITE_DB_PATH=data/patchshield.db

# Virtual Patching & Intelligence
OFFLINE_MODE=true
AUTO_ROLLBACK_FP_THRESHOLD=0.02
DEFAULT_CANARY_PERCENTAGE=5

# Agentic AI Guardrails
REQUIRE_OWNER_APPROVAL_FOR_ENFORCE=true
AGENT_AUTO_PTP_SANDBOX_RUN=true

# Notification Integrations (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_RECIPIENT=
WEBHOOK_URL=
